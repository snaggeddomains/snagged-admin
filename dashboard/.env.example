# Umbrella (app.snagged.com) dashboard environment.
# Set these in the Vercel project for the umbrella.

# Shared session-signing secret. MUST be byte-identical to research's
# AUTH_SECRET — that is what lets the umbrella verify research-issued cookies.
AUTH_SECRET=

# Supabase (shared identity store: domain_research_users). Service-role only —
# backend reads, never exposed to the browser.
SUPABASE_URL=https://njukyvzsisbvuyrtyyuf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Where the research app is reachable (login proxy + /research nesting target).
# During transition this is the live subdomain; after nesting it can stay the
# same origin behind the proxy.
RESEARCH_ORIGIN=https://research.snagged.com

# Cookie domain for the shared session. Leave as the apex so all subdomains and
# the umbrella share one session.
COOKIE_DOMAIN=.snagged.com

# Existing dashboard read access (pipeline state via GitHub Contents API).
GITHUB_TOKEN=
