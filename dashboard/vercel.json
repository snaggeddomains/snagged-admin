{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" != \"production\" ]; then exit 0; fi; git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . || exit 1",
  "crons": [
    { "path": "/api/cron/snap-run", "schedule": "0 8,9 * * *" },
    { "path": "/api/cron/snap-watchdog", "schedule": "0 11,12 * * *" },
    { "path": "/api/cron/sedo-net-new", "schedule": "0 10,11,17,18,23,0 * * *" },
    { "path": "/api/cron/x-ads-sync", "schedule": "0 6,14,22 * * *" },
    { "path": "/api/cron/newsletter-sync", "schedule": "0 12 * * 1" }
  ]
}
